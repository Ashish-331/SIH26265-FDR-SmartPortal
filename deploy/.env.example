# =============================================================================
# SIH Problem Statement 26265: AICTE Security Deposit / FDR Portal
# Environment Variables & Production Configuration Template
# File: deploy/.env.example
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# -----------------------------------------------------------------------------
NODE_ENV=production
ENVIRONMENT=production
LOG_LEVEL=info
TZ=Asia/Kolkata
APP_NAME="AICTE FDR Smart Portal"
APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# 2. POSTGRESQL 16 PRIMARY RELATIONAL DATABASE
# -----------------------------------------------------------------------------
POSTGRES_DB=aicte_fdr_db
POSTGRES_USER=aicte_admin
POSTGRES_PASSWORD=replace_with_strong_random_password_min_32_chars!
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aicte_admin:replace_with_strong_random_password_min_32_chars!@postgres:5432/aicte_fdr_db?sslmode=prefer
DB_POOL_MIN=10
DB_POOL_MAX=50
DB_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# 3. REDIS 7.2 HIGH SPEED CACHE & RATE LIMITER
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password_min_32_chars!
REDIS_URL=redis://:replace_with_strong_redis_password_min_32_chars!@redis:6379/0
REDIS_SESSION_TTL_SECONDS=86400

# -----------------------------------------------------------------------------
# 4. APACHE KAFKA 3.6 (EVENT CHOREOGRAPHY & ASYNC PIPELINE)
# -----------------------------------------------------------------------------
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=aicte-fdr-platform
KAFKA_CONSUMER_GROUP=aicte-fdr-workers
KAFKA_TOPIC_FDR_SUBMITTED=fdr.events.submitted
KAFKA_TOPIC_OCR_PROCESSED=fdr.events.ocr_completed
KAFKA_TOPIC_BANK_VERIFIED=fdr.events.bank_verified
KAFKA_TOPIC_LIEN_MARKED=fdr.events.lien_marked
KAFKA_TOPIC_AUDIT_LOGGED=fdr.events.audit_logged

# -----------------------------------------------------------------------------
# 5. MINIO / AWS S3 OBJECT STORAGE (SCANNED FDR CERTS & NOC LETTERS)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=aicte_s3_admin
MINIO_ROOT_PASSWORD=replace_with_s3_superadmin_password_min_32_chars!
MINIO_BUCKET_NAME=aicte-fdr-documents
MINIO_USE_SSL=false
MINIO_REGION=ap-south-1
S3_PRESIGNED_URL_EXPIRY_SECONDS=3600

# -----------------------------------------------------------------------------
# 6. INTERNAL MICROSERVICE ENDPOINTS (FOR K8S / DOCKER COMPOSE)
# -----------------------------------------------------------------------------
FDR_SERVICE_URL=http://fdr-service:8000
BANK_GATEWAY_URL=http://bank-gateway:8001
OCR_SERVICE_URL=http://ocr-service:8002
AUDIT_SERVICE_URL=http://audit-service:8003

# -----------------------------------------------------------------------------
# 7. BANK CBS INTEGRATION CREDENTIALS (SCHEDULED COMMERCIAL BANKS)
# -----------------------------------------------------------------------------
# State Bank of India (SBI) CBS Connector
SBI_CBS_API_URL=https://api.sbi.co.in/cbs/v1/fdr
SBI_CBS_CLIENT_ID=sbi_aicte_prod_client_id
SBI_CBS_CLIENT_SECRET=replace_with_sbi_mutual_tls_secret
SBI_CBS_BRANCH_ROUTING_CODE=SBIN0000691

# Punjab National Bank (PNB) CBS Connector
PNB_CBS_API_URL=https://api.pnb.co.in/cbs/v2/term-deposit
PNB_CBS_API_KEY=pnb_aicte_corporate_api_key_secure

# HDFC Bank CBS Connector
HDFC_CBS_API_URL=https://api.hdfcbank.com/corporate/cbs/v1
HDFC_CBS_CLIENT_ID=hdfc_aicte_client_id_001

# Bank Mock Mode Toggle (Set false for live Core Banking APIs)
MOCK_CBS_MODE=true

# -----------------------------------------------------------------------------
# 8. SECURITY & CRYPTOGRAPHY SECRETS
# -----------------------------------------------------------------------------
# JWT Authentication Signing Key (Min 256 bits)
JWT_SECRET=replace_with_generated_jwt_secret_key_at_least_64_characters_long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption Key for sensitive database fields (AES-256-GCM 32 bytes base64)
FIELD_ENCRYPTION_KEY_BASE64=YTFjMmUzZDQ1NmI3OGExYzJlM2Q0NTZiNzhhMWMyZTM=

# Audit Ledger Genesis Secret
AUDIT_GENESIS_SECRET=AICTE_FDR_SMART_PORTAL_ROOT_HASH_SEED_2026

# -----------------------------------------------------------------------------
# 9. OCR & FORENSIC FRAUD DETECTION CONFIGURATION
# -----------------------------------------------------------------------------
OCR_ENGINE=tesseract_paddle_hybrid
OCR_CONFIDENCE_THRESHOLD=0.85
FRAUD_RISK_ALERT_THRESHOLD=50.0
MAX_UPLOAD_FILE_SIZE_MB=25
ALLOWED_FILE_TYPES=application/pdf,image/png,image/jpeg

# -----------------------------------------------------------------------------
# 10. OBSERVABILITY & METRICS
# -----------------------------------------------------------------------------
PROMETHEUS_METRICS_PATH=/metrics
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=aicte-fdr-portal
